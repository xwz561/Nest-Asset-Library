{
  "name": "nest-asset-library",
  "private": true,
  "version": "1.8.5",
  "description": "Nest 本地素材资源库",
  "author": {
    "name": "xwz"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "package:win": "npm run build && electron-builder --win nsis --config.artifactName=Nest-Asset-Library-${version}-Setup.${ext} && electron-builder --win portable --config.artifactName=Nest-Asset-Library-${version}-Portable.${ext}",
    "icon:mac": "electron scripts/generate-mac-icon.cjs",
    "package:mac": "npm run build && npm run icon:mac && electron-builder --mac dmg zip"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "cn.nest.assetlibrary",
    "productName": "Nest 素材库",
    "directories": {
      "output": "release-${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "browser-extension/**/*",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "browser-extension/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "xwz"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "artifactName": "Nest-Asset-Library-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Nest 素材库 ${version}",
      "artifactName": "Nest-Asset-Library-${version}-macOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
